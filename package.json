{
  "name": "micode",
  "version": "0.10.0",
  "description": "OpenCode plugin with Brainstorm-Research-Plan-Implement workflow",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "type": "module",
  "files": [
    "src",
    "dist",
    "INSTALL_CLAUDE.md"
  ],
  "scripts": {
    "prepare": "echo 'Skipping lefthook install on unsupported platform'",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "lint": "biome lint . && eslint .",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint .",
    "check": "biome check . && eslint . && npm run typecheck && npm test",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "opencode",
    "plugin",
    "research",
    "plan",
    "implement"
  ],
  "author": "vtemian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vtemian/micode.git"
  },
  "homepage": "https://github.com/vtemian/micode#readme",
  "bugs": {
    "url": "https://github.com/vtemian/micode/issues"
  },
"dependencies": {
    "@opencode-ai/plugin": "1.14.19",
    "fts5-sql-bundle": "^1.0.0",
    "jsonc-parser": "^3.3.1",
    "valibot": "^1.2.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.2",
    "zigpty": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "eslint": "^10.0.3",
    "eslint-plugin-sonarjs": "^4.0.2",
    "eslint-plugin-unicorn": "^72.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^2.0.0"
  }
}
